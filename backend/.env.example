# Modelin 퀀트 투자 플랫폼 환경변수

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Upbit API (암호화폐 자동매매용)
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ENVIRONMENT=paper
ALPACA_API_KEY=
ALPACA_API_SECRET=
PAPER_WORKER_ENABLED=false
PAPER_DEPLOYMENT_FILE=docs/examples/kis-paper-runner.json
PAPER_WORKER_INTERVAL_SECONDS=300

# Server
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Data
CACHE_TTL_SECONDS=300
MAX_OHLCV_DAYS=3650
