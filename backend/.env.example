# Modelin 퀀트 투자 플랫폼 환경변수

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Upbit API (암호화폐 자동매매용)
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
# 같은 종합계좌를 쓰면 비워두고 KIS_ACCOUNT_NO를 공유합니다.
KIS_KRX_ACCOUNT_NO=
KIS_US_ACCOUNT_NO=
KIS_ENVIRONMENT=paper

# 미국주식은 PAPER_ALLOWED_MARKETS에 us를 명시할 때만 Paper 워커를 활성화합니다.

# 뉴스·공시 수집 (선택)
# RSS URL은 쉼표로 구분합니다.
NEWS_FEEDS=https://www.federalreserve.gov/feeds/press_all.xml,https://www.federalreserve.gov/feeds/press_monetary.xml
OPENDART_API_KEY=
SEC_USER_AGENT=Modelin contact@example.com
# US symbols are discovered from the NASDAQ/NYSE/AMEX listing when universe=market.
SEC_CIKS=0000320193,0000789019,0001045810,0001181412
FRED_API_KEY=

# Paper worker
PAPER_WORKER_ENABLED=false
PAPER_DEPLOYMENT_FILE=docs/examples/kis-paper-runner.json
# 국내 전략만 먼저 실행. 해외를 별도로 시작할 때 krx,us 로 변경합니다.
PAPER_ALLOWED_MARKETS=krx
PAPER_WORKER_INTERVAL_SECONDS=300
PAPER_DB_PATH=modelin-paper.sqlite3
PAPER_DEFAULT_INITIAL_CASH=0

# Server
DEBUG=true
MODEL_API_KEY=
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Data
CACHE_TTL_SECONDS=300
MAX_OHLCV_DAYS=3650
