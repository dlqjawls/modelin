# Modelin 퀀트 투자 플랫폼 환경변수

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Upbit API (암호화폐 자동매매용)
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ENVIRONMENT=paper

# 미국주식은 KIS 해외주식 어댑터 구현 후 활성화

# 뉴스·공시 수집 (선택)
# RSS URL은 쉼표로 구분합니다.
NEWS_FEEDS=
OPENDART_API_KEY=
SEC_USER_AGENT=Modelin contact@example.com
# Current US example deployment: AAPL, MSFT, NVDA, SPCX (SpaceX)
SEC_CIKS=0000320193,0000789019,0001045810,0001181412
FRED_API_KEY=

# Paper worker
PAPER_WORKER_ENABLED=false
PAPER_DEPLOYMENT_FILE=docs/examples/kis-paper-runner.json
PAPER_WORKER_INTERVAL_SECONDS=300
PAPER_DB_PATH=modelin-paper.sqlite3

# Server
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Data
CACHE_TTL_SECONDS=300
MAX_OHLCV_DAYS=3650
